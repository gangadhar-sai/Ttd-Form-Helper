{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "TTD Form Helper",
      "default_popup": "popup/index.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content/page-bridge.js" ],
      "matches": [ "https://tirupatibalaji.ap.gov.in/*", "https://ttdevasthanams.ap.gov.in/*" ],
      "run_at": "document_idle",
      "world": "MAIN"
   }, {
      "all_frames": false,
      "js": [ "content/autofill.js" ],
      "matches": [ "https://tirupatibalaji.ap.gov.in/*", "https://ttdevasthanams.ap.gov.in/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'"
   },
   "default_locale": "en",
   "description": "__MSG_extension_description__",
   "host_permissions": [ "https://tirupatibalaji.ap.gov.in/*", "https://ttdevasthanams.ap.gov.in/*" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "minimum_chrome_version": "114",
   "name": "__MSG_extension_name__",
   "options_ui": {
      "open_in_tab": true,
      "page": "options/index.html"
   },
   "permissions": [ "storage", "sidePanel" ],
   "side_panel": {
      "default_path": "popup/index.html"
   },
   "version": "1.4.5"
}
